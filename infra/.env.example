# Mẫu biến môi trường cho docker compose (infra/docker-compose.yml).
# Sao chép thành `infra/.env` (đã nằm trong .gitignore) rồi ĐỔI hết giá trị "change-me".
# KHÔNG commit file .env thật; ở pilot, mật khẩu do người vận hành đặt và giữ ngoài repo (docs/09 §11.4).

# --- Postgres (superuser chỉ dùng cho khởi tạo/migration, service KHÔNG dùng) ---
POSTGRES_DB=denguesense
POSTGRES_USER=denguesense_admin
POSTGRES_PASSWORD=change-me

# --- Mật khẩu user DB riêng từng service (mỗi service chỉ có quyền trên schema của mình) ---
SVC_IDENTITY_PASSWORD=change-me
SVC_SURVEILLANCE_PASSWORD=change-me
SVC_FORECAST_PASSWORD=change-me
SVC_OPTIMIZE_PASSWORD=change-me
SVC_WORKFLOW_PASSWORD=change-me
SVC_GENAI_PASSWORD=change-me
SVC_NOTIFICATION_PASSWORD=change-me

# --- Gateway ---
# Gateway lấy khoá xác minh access token từ JWKS của identity. Khoá CÔNG KHAI dưới đây chỉ còn để
# surveillance/forecast kiểm token DỊCH VỤ (dev dùng chung một cặp khoá). Tạo cặp khoá dev:
#   cd backend && go run ./cmd/devtool keygen
# rồi dán dòng PUBLIC vào đây; giữ PRIVATE trong infra/.env.devtool (đã bị .gitignore), KHÔNG commit/dán vào chat.
GATEWAY_JWT_PUBLIC_KEY=change-me

# --- Identity ---
# Khoá RIÊNG Ed25519 (base64) để ký token; phần công khai tương ứng PHẢI là GATEWAY_JWT_PUBLIC_KEY ở trên (dev).
#   cd backend && go run ./cmd/devtool keygen   → PRIVATE=… vào đây, PUBLIC=… vào GATEWAY_JWT_PUBLIC_KEY
IDENTITY_JWT_PRIVATE_KEY=change-me
# SHA-256 (hex) của client_secret của gateway:  cd backend && go run ./cmd/devtool secret
#   → SECRET=… vào GATEWAY_SERVICE_CLIENT_SECRET (gateway xin token dịch vụ), SHA256=… vào biến bên dưới. KHÔNG commit.
GATEWAY_SERVICE_CLIENT_SECRET=change-me
IDENTITY_SERVICE_SECRET_SHA256_GATEWAY=change-me
# forecast xin token dịch vụ để tải panel từ surveillance: sinh bằng `go run ./cmd/devtool secret`
#   → SECRET=… vào FORECAST_SERVICE_CLIENT_SECRET, SHA256=… vào IDENTITY_SERVICE_SECRET_SHA256_FORECAST.
FORECAST_SERVICE_CLIENT_SECRET=change-me
IDENTITY_SERVICE_SECRET_SHA256_FORECAST=change-me

# --- (Tuỳ chọn, chỉ máy dev) Cổng phía host khi dùng docker-compose.dev.yml ---
# Đổi nếu cổng mặc định bị chiếm (vd đã cài Postgres cục bộ) hoặc bị Windows giữ chỗ.
# POSTGRES_HOST_PORT=5432
# NATS_HOST_PORT=4222
# NATS_MONITOR_HOST_PORT=8222
# GATEWAY_HOST_PORT=8080
# FORECAST_HOST_PORT=8001
# IDENTITY_HOST_PORT=8081
