{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "no-console": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Gọi API qua shared/api (client.ts hoặc static.ts), không gọi fetch trực tiếp."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "react-router", "message": "Dùng @tanstack/react-router." },
          { "name": "axios", "message": "Dùng client trong shared/api." }
        ]
      }
    ],
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["src/shared/api/**"],
      "rules": { "no-restricted-globals": "off" }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/test/**",
        "src/mocks/**",
        "e2e/**",
        "scripts/**"
      ],
      "rules": { "no-restricted-globals": "off", "no-console": "off" }
    },
    {
      "files": ["src/app/routes/**"],
      "rules": { "react/only-export-components": "off" }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    "coverage",
    "playwright-report",
    "src/shared/api/schema.gen.ts",
    "src/app/routeTree.gen.ts"
  ]
}
